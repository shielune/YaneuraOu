{
  "name": "@ultemica/yaneuraou-wasm-pthread-nagisa",
  "version": "8.50.0",
  "description": "YaneuraOu shogi engine for browsers (Wasm, multi-threaded via pthread / SharedArrayBuffer, NNUE NAGISA V3.1 SFNN HalfKA_hm2_1024x2_15_64 — NAGISA V3.1 compatible network)",
  "license": "GPL-3.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/yaneuraou.js",
    "dist/yaneuraou.wasm",
    "README.md",
    "SPEC.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./wasm": "./dist/yaneuraou.wasm",
    "./engine": "./dist/yaneuraou.js"
  },
  "scripts": {
    "build:wasm": "act workflow_dispatch -W ../.github/workflows/build-pthread-kp256.yml --bind",
    "build:loader": "bun tsc",
    "build": "bun run build:wasm && bun run build:loader",
    "test:e2e": "bun run test/run.ts"
  },
  "devDependencies": {
    "playwright": "^1.59.1",
    "typescript": "^5.0.0"
  }
}
