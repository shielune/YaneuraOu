{
  "name": "@ultemica/yaneuraou-mate-cfworkers",
  "version": "8.50.0",
  "description": "YaneuraOu mate (tsume) solver for Cloudflare Workers / browser (Wasm, single-thread, no SharedArrayBuffer)",
  "license": "GPL-3.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/yaneuraou.js",
    "dist/yaneuraou.wasm",
    "README.md",
    "SPEC.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./wasm": "./dist/yaneuraou.wasm",
    "./engine": "./dist/yaneuraou.js"
  },
  "scripts": {
    "build:wasm": "act workflow_dispatch -W ../.github/workflows/build-mate-cfworkers.yml --bind",
    "build:loader": "bun tsc",
    "build": "bun run build:wasm && bun run build:loader"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240000.0",
    "typescript": "^5.0.0"
  }
}
